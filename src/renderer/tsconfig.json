{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out/renderer",
    "rootDir": "../..",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/**/*.ts",
    "./src/themes/*.json",
    "../../resources/permission-rules.ts",
    "../../resources/permission-rules.test.ts",
    "../../resources/permission-prompt-text.ts",
    "../../resources/permission-prompt-text.test.ts",
    "../../resources/path-within.ts",
    "../../resources/path-within.test.ts",
    "../../resources/repo-set-map.ts",
    "../../resources/repo-set-map.test.ts",
    "../../resources/next-steps.ts",
    "../../resources/next-steps.test.ts",
    "../../resources/system-prompt.ts",
    "../../resources/system-prompt.test.ts",
    "../../resources/context-snapshot.ts",
    "../../resources/context-snapshot.test.ts",
    "../../resources/locales/*/translation.json",
    "../../packages/pi-analytics/report/**/*.tsx",
    "../../packages/pi-analytics/src/cache-plan.ts",
    "../../packages/pi-analytics/src/recommendations.ts",
    "../../packages/pi-analytics/src/envelope.ts",
    "../../packages/pi-analytics/sessions/**/*.tsx",
    "../../packages/pi-analytics/src/live/envelope.ts"
  ]
}
